{ "cleanUrls": true, "trailingSlash": false,
  "headers": [
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" }] },
    { "source": "/favicon.svg", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }] }
  ] }
